# Optional. Copy to ".env" only if you need to change something.

# Where the API lives. Leave empty in development (Vite forwards /api to http://localhost:4000).
# VITE_API_URL=https://your-api.example.com/api

# Map tiles. The default is the public OpenStreetMap tile server, which is fine for development and
# demos but not for heavy traffic. See https://operations.osmfoundation.org/policies/tiles/
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
