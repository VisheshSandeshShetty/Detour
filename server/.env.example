# Copy this file to ".env" and fill in your own values. Never commit ".env".

# --- Server ---
PORT=4000
NODE_ENV=development
# Where the React app runs (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/detour?schema=public"

# --- Authentication ---
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# --- External services (all free, no API keys needed) ---
# Put YOUR real email here. It goes in the User-Agent header. Overpass and OpenStreetMap
# services ask every app to identify itself and may refuse anonymous or generic requests.
CONTACT_EMAIL=your-real-email@example.com

# OSRM routing. The public demo server is for light use only. Host your own for real traffic.
OSRM_URL=https://router.project-osrm.org
# Photon geocoder (location search / autocomplete)
PHOTON_URL=https://photon.komoot.io
# Overpass servers, tried in order. Leave this line OUT to use the built-in list
# (overpass.openstreetmap.fr, overpass-api.de, overpass.private.coffee, overpass.kumi.systems).
# If you set it, list the servers separated by commas:
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# --- Limits ---
# Longest journey (km) Detour will search along
MAX_ROUTE_KM=1200
# Pause between routing batches in milliseconds (be polite to the public OSRM server)
OSRM_DELAY_MS=500


